# =========================================================================
# OSIRIS Imhotep — Engineering SOW backend configuration
# Copy to backend/.env and fill in real values.
# =========================================================================

# --- DeepSeek API (REQUIRED) ---
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini vision API (required for image and video analysis) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Google Docs export (recommended: Service Account for MVP) ---
# 1) Create a Service Account in Google Cloud Console and download its JSON key,
#    then point GOOGLE_SERVICE_ACCOUNT_FILE at it.
# 2) Share the target folder / doc or enable "Google Workspace Domain-wide
#    Delegation" so the SA can create + share docs.
# Service accounts are typically "writer" on docs they create; the resulting
# doc is owned by the SA. Use GOOGLE_DOCS_IMPERSONATE (domain-wide delegation)
# so the doc is created under a real user, or pass the owner_email so the doc
# is shared back to the requesting engineer.
# For GCP deployments (docker-compose) prefer the SA over the OAuth user token.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_DOCS_IMPERSONATE=

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=50
MAX_VIDEO_FRAMES=6
TEMP_DIR=tmp_uploads

# --- Future RAG plug-in (leave RAG_PROVIDER=null for the MVP) ---
# When a private vector DB for internal pricing / SOPs is ready, implement
# app/services/rag_provider.py and set RAG_PROVIDER=vector + endpoint below.
# The rest of the system (prompt builder, UI) needs no changes.
RAG_PROVIDER=null
RAG_ENDPOINT=
RAG_API_KEY=

# --- Auth (SSO login gate) ---
# JWT_SECRET signs login tokens — set a long random value (leave empty to
# auto-generate + persist in data/.jwt_secret).
JWT_SECRET=
TOKEN_EXPIRY_HOURS=12
AUTH_DB_PATH=data/users.db

# Default superadmin, created on first run only when no users exist.
SUPERADMIN_USERNAME=admin
SUPERADMIN_DISPLAY_NAME=System Administrator
SUPERADMIN_EMAIL=
# If empty, a random password is generated and printed to the backend log once.
SUPERADMIN_PASSWORD=
