# OSIRIS Imhotep - Caddyfile
# Test address: HTTP only, no TLS, no redirect.
# For production: uncomment the yourdomain.com block and set DNS A record.
{
    admin off
}

# IP-based address - HTTP only, no auto-HTTPS redirect.
35.187.242.177:80 {
    encode zstd gzip

    # API -> FastAPI (uvicorn :8000); allow up to 300s for AI calls.
    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                response_header_timeout 300s
            }
        }
    }

    # Everything else -> Next.js (:3000).
    handle {
        reverse_proxy frontend:3000
    }
}

