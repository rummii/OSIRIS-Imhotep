# OSIRIS Imhotep — backend image (FastAPI + uvicorn)
FROM python:3.12-slim

# opencv-python-headless runtime dependency
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
# sqlite-vec: bundled SQLite extension, no system deps needed

COPY backend/app ./app

# Persistent data lives on volumes mounted here:
#   ./data        -> /app/data        (SQLite users.db)
#   ./credentials -> /app/credentials (Google SA key / OAuth token)
RUN mkdir -p /app/data /app/credentials /app/tmp_uploads

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# Cloud Run injects $PORT (default 8080); fall back to 8000 locally/docker-compose.
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --log-level info"]
