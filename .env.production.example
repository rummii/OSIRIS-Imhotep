# OSIRIS Imhotep — production environment template (docker-compose / self-hosted VM only)
# Copy to .env.production and fill in real values (never commit the real file).
#
# NOTE: the recommended Google Cloud target is Cloud Run (deploy/gcp-setup.md):
# environment values are stored in Secret Manager and attached by the GitHub
# Actions workflow (deploy/.github/workflows/deploy.yml). This file is used by
# the legacy docker-compose flow on a VM.

# --- DeepSeek API (REQUIRED) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini vision API (required for image / video analysis) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Google Docs export ---
# On GCP use a Service Account key (recommended). Download the JSON from
# IAM > Service Accounts and save it as ./credentials/osiris-sa.json.
# On Cloud Run the workflow injects GOOGLE_SERVICE_ACCOUNT_JSON (Secret Manager)
# and the app materialises it to GOOGLE_SERVICE_ACCOUNT_FILE at startup.
# GOOGLE_DOCS_IMPERSONATE=<someone@yourdomain.com> for Workspace domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/osiris-sa.json
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_DOCS_IMPERSONATE=

# --- App ---
CORS_ORIGINS=https://yourdomain.com
MAX_UPLOAD_MB=50
MAX_VIDEO_FRAMES=6
TEMP_DIR=tmp_uploads

# --- Auth ---
JWT_SECRET=CHANGE_ME_to_a_long_random_value
TOKEN_EXPIRY_HOURS=12
# SQLite (local / VM) or PostgreSQL on Cloud SQL (Cloud Run):
#   postgres+pg8000://user:pass@/dbname?unix_sock=/cloudsql/PROJECT:REGION:INSTANCE/.s.PGSQL.5432
DATABASE_URL=
AUTH_DB_PATH=data/users.db
SUPERADMIN_USERNAME=admin
SUPERADMIN_DISPLAY_NAME=System Administrator
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=CHANGE_ME

# --- RAG (leave null for MVP) ---
RAG_PROVIDER=null
RAG_ENDPOINT=
RAG_API_KEY=
